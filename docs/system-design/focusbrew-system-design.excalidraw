d": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false}, {"id": "s230", "type": "text", "x": 1138, "y": 2014, "width": 109.20000000000002, "height": 16.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 760886665, "version": 1, "versionNonce": 301796989, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false, "text": "retenção (90 d)", "originalText": "retenção (90 d)", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "baseline": 11, "autoResize": true}, {"id": "s231", "type": "rectangle", "x": 40, "y": 2080, "width": 1260, "height": 200, "angle": 0, "strokeColor": "#f59e0b", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 612657719, "version": 1, "versionNonce": 380335157, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false}, {"id": "s232", "type": "text", "x": 60, "y": 2094, "width": 369.6, "height": 27.5, "angle": 0, "strokeColor": "#92400e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 331818809, "version": 1, "versionNonce": 697165923, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false, "text": "Pontos fracos (README seção 8)", "originalText": "Pontos fracos (README seção 8)", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "baseline": 19, "autoResize": true}, {"id": "s233", "type": "text", "x": 60, "y": 2134, "width": 1260.0000000000002, "height": 93.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 849881169, "version": 1, "versionNonce": 605632247, "isDeleted": false, "boundElements": null, "updated": 1730000000000, "link": null, "locked": false, "text": "1. tasks.json, activity.json e settings.json: fs::write não atômico + parse com unwrap_or_default → arquivo truncado vira lista vazia e é sobrescrito.\n    (notes.rs já faz certo: tmp + rename + quarentena do arquivo corrompido)\n2. Cada mutação regrava 2 arquivos inteiros.   3. API do serviço sem autenticação (porta fixa 8765, só 127.0.0.1).\n4. Sincronia com Google: o último que editou vence, e isso depende dos relógios.   5. Retenções sem relação: 400 d, 90 d, sem limite.\n6. Sem CI (.github/workflows ausente).   7. Estado inteiro atrás de um Mutex: já causou deadlock (sync_ui).", "originalText": "1. tasks.json, activity.json e settings.json: fs::write não atômico + parse com unwrap_or_default → arquivo truncado vira lista vazia e é sobrescrito.\n    (notes.rs já faz certo: tmp + rename + quarentena do arquivo corrompido)\n2. Cada mutação regrava 2 arquivos inteiros.   3. API do serviço sem autenticação (porta fixa 8765, só 127.0.0.1).\n4. Sincronia com Google: o último que editou vence, e isso depende dos relógios.   5. Retenções sem relação: 400 d, 90 d, sem limite.\n6. Sem CI (.github/workflows ausente).   7. Estado inteiro atrás de um Mutex: já causou deadlock (sync_ui).", "fontSize": 15, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.25, "baseline": 13, "autoResize": true}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}